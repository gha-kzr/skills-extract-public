# Copy to .env and fill in what you need: cp .env.example .env
# Only the scripts you run need their variables.

# llm_extract.py: any OpenAI-compatible endpoint (hosted API or local Ollama)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=gemma3:4b

# jev_extract.py: TypeSafe API key (https://typesafe.ai)
TYPESAFE_API_KEY=
